# =============================================================================
# .env.example  —  copy to .env (which is gitignored) and adjust if you like.
#   cp .env.example .env
#
# These values are read by docker-compose.yml (the db box) AND by the app code
# (boot_check.py, web services, core/apply_schema.py). Inside Docker the app
# reaches the other boxes BY SERVICE NAME (host=db, ollama at ollama:11434) — so
# the defaults below already match the compose network. Only change the password.
# =============================================================================

# ---- Postgres / pgvector (the db box) ----
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_pw_2026
POSTGRES_DB=rag_lab

# ---- how the APP reaches the db box (service name on the compose network) ----
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- how the APP reaches the ollama box ----
OLLAMA_BASE_URL=http://ollama:11434

# ---- Django (dev defaults; override for any real deployment) ----
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-insecure-key-change-me-in-production
DJANGO_ALLOWED_HOSTS=*

# ---- Claude API (ONLY for the final demo; leave empty for $0 Ollama dev) ----
# ANTHROPIC_API_KEY=

# ---- optional image tag pins (compose has sane defaults) ----
# PGVECTOR_IMAGE_TAG=pg17-trixie
# OLLAMA_IMAGE_TAG=latest
