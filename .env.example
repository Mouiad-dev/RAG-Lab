# RAG Lab — environment template. Copy to `.env` and fill real values.
# `.env` is gitignored (holds the real secret); only this example is committed.

# --- PostgreSQL (the pgvector store) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=test2026
POSTGRES_DB=rag_lab
POSTGRES_HOST=db          # "db" inside docker-compose; "localhost" for host runs
POSTGRES_PORT=5432

# --- Ollama (local LLM + embeddings) ---
OLLAMA_BASE_URL=http://ollama:11434   # "http://localhost:11434" for host runs

# --- Anthropic (demo LLM) — put the real key only in .env, never here ---
ANTHROPIC_API_KEY=sk-ant-...

# --- LLM selection (Factory reads these) ---
LLM_PROVIDER=ollama                   # ollama | anthropic
# Per-provider model override (optional). If unset, the adapter's own default is used
# (ollama: qwen2.5:0.5b, anthropic: claude-haiku-4-5).
# OLLAMA_MODEL=qwen2.5:0.5b
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- Celery / Redis (async ingestion, Step 2.2) ---
# Defaults in settings already point at the compose `redis` service; override for host runs.
CELERY_BROKER_URL=redis://redis:6379/0      # "redis://localhost:6379/0" for host runs
CELERY_RESULT_BACKEND=redis://redis:6379/1
